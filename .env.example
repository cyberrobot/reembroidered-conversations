# NEXT_PUBLIC_MUX_PLAYBACK_ID: Optional public Mux Playback ID for the hero video.
# This is intentionally browser-visible. Use a Playback ID, not a Mux Asset ID.
# When omitted or invalid, the application falls back to its verified default stream.
NEXT_PUBLIC_MUX_PLAYBACK_ID=

# Required, server-only PostgreSQL connection string used by Prisma at runtime
# and when applying database migrations. Never expose this as NEXT_PUBLIC_*.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Required, server-only canonical public application origin. The Google OAuth
# callback is APP_URL + /api/admin/google-calendar/callback.
APP_URL="http://localhost:3000"

# Required, server-only Stripe test/live secret key used to create Checkout Sessions.
STRIPE_SECRET_KEY="replace-with-stripe-secret-key"

# Required, server-only signing secret for POST /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET="replace-with-stripe-webhook-signing-secret"

# Required, server-only Google OAuth Web Application credentials.
GOOGLE_OAUTH_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_OAUTH_CLIENT_SECRET="replace-with-google-oauth-client-secret"

# Required, server-only allowlisted practitioner Google email address.
GOOGLE_ADMIN_EMAIL="practitioner@example.com"

# Required, server-only base64 encoding of exactly 32 random bytes for AES-256-GCM.
GOOGLE_TOKEN_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"

# Required, server-only secret of at least 32 bytes for signed admin/OAuth cookies.
ADMIN_SESSION_SECRET="replace-with-a-random-secret-at-least-32-bytes-long"

# Required, server-only Resend credential and verified sender used for booking
# confirmation emails after durable Calendar/Meet finalisation.
RESEND_API_KEY="replace-with-resend-api-key"
BOOKING_EMAIL_FROM="Re-Embroidered Conversations <bookings@example.com>"

# Required, server-only trusted base URL for secure customer booking management.
# The email service appends a booking-specific signed capability. Must be HTTPS
# in production; do not put a customer token in this environment variable.
BOOKING_CHANGES_URL="https://example.com/booking/manage"

# Required, server-only high-entropy secret (at least 32 bytes) used to sign
# deterministic booking-management capabilities. Never expose as NEXT_PUBLIC_*.
BOOKING_MANAGEMENT_SECRET="replace-with-a-random-secret-at-least-32-bytes-long"

# Public Cloudflare Turnstile widget key and server-only verification secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="replace-with-turnstile-site-key"
TURNSTILE_SECRET_KEY="replace-with-turnstile-secret-key"
TURNSTILE_EXPECTED_HOSTNAME="example.com"

# Server-only abuse protection configuration. Set the header only after the
# production proxy/CDN is confirmed to overwrite it with the real client IP.
TRUSTED_CLIENT_IP_HEADER="cf-connecting-ip"
ABUSE_PROTECTION_HMAC_SECRET="replace-with-a-random-secret-at-least-32-bytes-long"
