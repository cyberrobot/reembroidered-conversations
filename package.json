{
  "name": "re-embroidered-conversations",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "clean": "rm -rf .next",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:audit": "npm audit --audit-level=high",
    "lint": "tsc --noEmit",
    "test": "node --conditions=react-server --experimental-test-module-mocks --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "booking:reconcile:scheduled": "node scripts/invoke-booking-reconciliation.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@mux/mux-player-react": "^3.14.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "stripe": "^23.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "autoprefixer": "^10.6.1",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
