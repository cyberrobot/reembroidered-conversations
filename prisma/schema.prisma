generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// HOLD, PAID, and CONFIRMED own their selected slot. CANCELLED and REFUNDED
/// are inactive and release it. Lifecycle transitions are implemented later.
enum BookingStatus {
  HOLD
  PAID
  CONFIRMED
  CANCELLED
  REFUNDED
}

model Booking {
  id                      String        @id @default(uuid()) @db.Uuid
  name                    String
  email                   String
  startAt                 DateTime      @db.Timestamptz(3)
  endAt                   DateTime      @db.Timestamptz(3)
  timezone                String
  status                  BookingStatus @default(HOLD)
  stripeCheckoutSessionId String?       @unique(map: "bookings_stripe_checkout_session_id_key")
  stripePaymentIntentId   String?       @unique(map: "bookings_stripe_payment_intent_id_key")
  calendarEventId         String?       @unique(map: "bookings_calendar_event_id_key")
  meetingUrl              String?
  boundariesAcceptedAt    DateTime?     @db.Timestamptz(3)
  confirmationEmailSentAt DateTime?     @db.Timestamptz(3)
  confirmationEmailId     String?
  cancelledAt             DateTime?     @db.Timestamptz(3)
  cancellationRefundDue   Boolean?
  calendarCancelledAt     DateTime?     @db.Timestamptz(3)
  stripeRefundId          String?       @unique(map: "bookings_stripe_refund_id_key")
  stripeRefundStatus      String?
  refundRequestedAt       DateTime?     @db.Timestamptz(3)
  refundedAt              DateTime?     @db.Timestamptz(3)
  rescheduledAt           DateTime?     @db.Timestamptz(3)
  rescheduleSourceBookingId String?      @unique(map: "bookings_reschedule_source_booking_id_key") @db.Uuid
  rescheduleSourceBooking Booking?       @relation("BookingReschedule", fields: [rescheduleSourceBookingId], references: [id], onDelete: SetNull)
  rescheduleHold          Booking?       @relation("BookingReschedule")
  expiresAt               DateTime      @db.Timestamptz(3)
  createdAt               DateTime      @default(now()) @db.Timestamptz(3)

  @@index([startAt], map: "bookings_start_at_idx")
  @@index([status, expiresAt], map: "bookings_status_expires_at_idx")
  @@map("bookings")
}

model GoogleCalendarConnection {
  id                    String   @id
  googleSubject         String
  googleEmail           String
  calendarId            String
  calendarSummary       String
  calendarTimeZone      String?
  refreshTokenEncrypted String   @db.Text
  grantedScopes         String[]
  connectedAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  @@map("google_calendar_connections")
}

model AbuseRateLimit {
  key         String
  windowStart DateTime @db.Timestamptz(3)
  count       Int
  expiresAt   DateTime @db.Timestamptz(3)
  @@id([key, windowStart])
  @@index([expiresAt], map: "abuse_rate_limits_expires_at_idx")
  @@map("abuse_rate_limits")
}

model AbuseHoldPermit {
  id        String   @id @db.Uuid
  clientKey String
  bookingId String?  @unique(map: "abuse_hold_permits_booking_id_key") @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  @@index([clientKey, expiresAt], map: "abuse_hold_permits_client_expiry_idx")
  @@map("abuse_hold_permits")
}
