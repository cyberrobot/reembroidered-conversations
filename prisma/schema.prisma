generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// HOLD, PAID, and CONFIRMED own their selected slot. CANCELLED and REFUNDED
/// are inactive and release it. Lifecycle transitions are implemented later.
enum BookingStatus {
  HOLD
  PAID
  CONFIRMED
  CANCELLED
  REFUNDED
}

model Booking {
  id                      String        @id @default(uuid()) @db.Uuid
  name                    String
  email                   String
  startAt                 DateTime      @db.Timestamptz(3)
  endAt                   DateTime      @db.Timestamptz(3)
  timezone                String
  status                  BookingStatus @default(HOLD)
  stripeCheckoutSessionId String?       @unique(map: "bookings_stripe_checkout_session_id_key")
  stripePaymentIntentId   String?       @unique(map: "bookings_stripe_payment_intent_id_key")
  calendarEventId         String?       @unique(map: "bookings_calendar_event_id_key")
  meetingUrl              String?
  expiresAt               DateTime      @db.Timestamptz(3)
  createdAt               DateTime      @default(now()) @db.Timestamptz(3)

  @@index([startAt], map: "bookings_start_at_idx")
  @@index([status, expiresAt], map: "bookings_status_expires_at_idx")
  @@map("bookings")
}

model GoogleCalendarConnection {
  id                    String   @id
  googleSubject         String
  googleEmail           String
  calendarId            String
  calendarSummary       String
  calendarTimeZone      String?
  refreshTokenEncrypted String   @db.Text
  grantedScopes         String[]
  connectedAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  @@map("google_calendar_connections")
}

/// Short-lived replay ledger for completed or failed Google OAuth callbacks.
/// Only a SHA-256 digest is stored; raw OAuth state and PKCE material remain absent.
model GoogleOAuthStateConsumption {
  stateHash  String   @id @db.Char(64)
  expiresAt  DateTime @db.Timestamptz(3)
  consumedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([expiresAt], map: "google_oauth_state_consumptions_expires_at_idx")
  @@map("google_oauth_state_consumptions")
}
